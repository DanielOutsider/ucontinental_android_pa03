<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="16dp">

    <EditText android:id="@+id/edtName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Nombre"/>
    <EditText android:id="@+id/edtStock"  android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Stock" android:layout_marginTop="8dp"/>
    <EditText android:id="@+id/edtPrice" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Precio (S/.)" android:inputType="numberDecimal" android:layout_marginTop="8dp"/>
</LinearLayout>